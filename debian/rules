#!/usr/bin/make -f

PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/~.*//')
PKG_SOURCE  := $(shell jq -r '.name' composer.json)
PKG_TYPE    := $(shell jq -r '.type' composer.json)
PKG_ROOT    := debian/php-vitexsoftware-abraflexi-datatables

%:
	dh $@

override_dh_install:
	dh_install
	sed -i "s|'unknown'|'$(PKG_SOURCE)'|" \
		$(PKG_ROOT)/usr/share/php/AbraFlexiUiDataTables/autoload.php
	sed -i "s|'0.0.0'|'$(PKG_VERSION)'|" \
		$(PKG_ROOT)/usr/share/php/AbraFlexiUiDataTables/autoload.php
	sed -i "s|'library'|'$(PKG_TYPE)'|g" \
		$(PKG_ROOT)/usr/share/php/AbraFlexiUiDataTables/autoload.php
	# Register autoloader for pkg-php-tools
	install -m0755 -d $(PKG_ROOT)/usr/share/pkg-php-tools/autoloaders
	echo 'vitexsoftware datatables-abraflexi AbraFlexiUiDataTables/autoload.php' \
		> $(PKG_ROOT)/usr/share/pkg-php-tools/autoloaders/php-vitexsoftware-abraflexi-datatables
